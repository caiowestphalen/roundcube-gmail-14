{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/css/styles.css",
  "overrides": [
    {
      "files": ["skin/templates/**/*.html"],
      "options": { "parser": "html", "printWidth": 120, "htmlWhitespaceSensitivity": "ignore" }
    }
  ]
}
